# ---- 运行时数据（含 API Key、群聊记录，绝对不能进仓库）----
data/
.astrbot
astrbot.lock
logs/

# ---- Python 虚拟环境与缓存 ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---- 构建/下载的临时产物 ----
.tmp/
.pip-cache/
tools/
build/
dist/

# ---- NapCat 运行时与二进制（几百 MB）----
napcat/
*.zip
*.7z

# ---- 配置备份（含密钥）----
*.bak
*.bak-*
*.bak.*
*.orig

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
