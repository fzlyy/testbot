{
  "_comment": "对应 README 第 7 节。AstrBot WebUI → 配置文件 → 右下角 {} 编辑配置文件，按需对照修改；改完点『应用此配置』再点『保存配置』。data/cmd_config.json 里同样结构。",
  "platform_settings": {
    "unique_session": false,
    "reply_with_mention": false,
    "reply_with_quote": true,
    "forward_threshold": 1000,
    "empty_mention_waiting": true,
    "empty_mention_waiting_need_reply": true,
    "ignore_bot_self_message": true,
    "rate_limit": {
      "time": 60,
      "count": 30,
      "strategy": "stall"
    },
    "segmented_reply": {
      "enable": true,
      "only_llm_result": true,
      "interval_method": "random",
      "interval": "1.0,2.5",
      "words_count_threshold": 150,
      "regex": ".*?[。？！~…]+|.+$"
    }
  },
  "provider_settings": {
    "enable": true,
    "identifier": true,
    "group_name_display": true,
    "datetime_system_prompt": true,
    "max_context_length": 30,
    "dequeue_context_length": 2,
    "display_reasoning_text": false,
    "streaming_response": false
  },
  "provider_ltm_settings": {
    "group_icl_enable": true,
    "group_message_max_cnt": 30,
    "image_caption": false,
    "active_reply": {
      "enable": true,
      "method": "possibility_reply",
      "possibility_reply": 0.1,
      "whitelist": [
        "aiocqhttp:GroupMessage:替换成你的群号"
      ]
    }
  },
  "t2i": false,
  "timezone": "Asia/Shanghai"
}
